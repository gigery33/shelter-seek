generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pgcrypto]
}

enum ShelterType {
  BOMB_SHELTER
  UNDERGROUND_PARKING
  METRO
}

enum Amenity {
  WATER
  INTERNET
  ACCESSIBLE
}

enum ShelterStatus {
  OPEN
  CLOSED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Shelter {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  type        ShelterType
  description String?
  address     String
  lat         Float
  lng         Float
  amenities   Amenity[]
  capacity    Int
  photoUrl    String?
  status      ShelterStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("shelters")
}
